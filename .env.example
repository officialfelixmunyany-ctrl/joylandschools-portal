# Daraja Python Portal - environment configuration
# Copy to .env if you need local overrides. Do NOT commit .env.

# Server binding
PORT=3000
HOST=0.0.0.0

# Set to "production" on the live server.
APP_ENV=development

# Session signing secret. Required in production.
# Generate one with:
# python -c "import secrets; print(secrets.token_hex(48))"
SESSION_SECRET=

# Optional: timezone for school-day calculations.
SCHOOL_TIME_ZONE=Africa/Nairobi

# Optional: school portal confirmation email.
# When configured, new school portal requests send confirmation from this mailer.
SUPPORT_EMAIL=schools@civicom.org
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=schools@civicom.org
SMTP_STARTTLS=1

# Required in production if the resource-admin portal is enabled.
RESOURCE_ADMIN_USERNAME=admin
RESOURCE_ADMIN_PASSWORD=
