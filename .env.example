# Joyland Portal — environment configuration
# Copy to .env (gitignored) and set real values. Do NOT commit .env.

# Server binding
PORT=3000
HOST=0.0.0.0

# Set to "production" on the live server. This enables secure cookies and HSTS,
# and REQUIRES SESSION_SECRET to be set (the app refuses to boot without it).
NODE_ENV=development

# Session signing secret. REQUIRED in production. In development, if unset, a
# persistent random secret is generated at secrets/session-secret.txt.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Reverse-proxy trust. Defaults to 1 hop in production, off in development.
# Use a number (hop count), "true"/"false", or an express trust-proxy string.
# TRUST_PROXY=1

# Optional: timezone for school-day calculations (defaults to Africa/Nairobi)
# SCHOOL_TIME_ZONE=Africa/Nairobi
